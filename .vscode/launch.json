{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Uvicorn (port 8778)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["app:app", "--reload", "--port", "8778"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        },
        {
            "name": "Dataset: Uvicorn (port 7887)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["dataset:app", "--reload", "--port", "7887"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        }
    ]
}
